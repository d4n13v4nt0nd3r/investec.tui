# Investec Open Banking TUI configuration
#
# If you downloaded the app, save your filled-in copy of this file as
# "investec.env" in the folder the app shows you on first run:
#   macOS   ~/Library/Application Support/investec-tui/
#   Windows %APPDATA%\investec-tui\
#
# If you are working from a clone of the repo, copy it to .env instead:
#   cp env.example .env
#   nano .env
#
# Both .env and investec.env are gitignored. Never commit or share these values.

# Countries shown on the landing page, as {Name:CODE;Name:CODE}.
# Remove any country you do not bank in.
COUNTRY_LIST={South Africa:ZA;Mauritius:MU}

# South Africa credentials (from Investec Online -> Programmable Banking -> Open API)
ZA_CLIENT_ID=
ZA_CLIENT_SECRET=
ZA_API_KEY=

# Mauritius credentials
MU_CLIENT_ID=
MU_CLIENT_SECRET=
MU_API_KEY=

# Optional legacy fallback, used for any country above that has no <CODE>_* values.
# INVESTEC_CLIENT_ID=
# INVESTEC_CLIENT_SECRET=
# INVESTEC_API_KEY=
