# Investec Open Banking TUI configuration
#
# Copy this file to .env in the project root and fill in your own values:
#   cp env.example .env
#   nano .env
#
# The .env file is gitignored. Never commit or share these values.

# Countries shown on the landing page, as {Name:CODE;Name:CODE}.
# Remove any country you do not bank in.
COUNTRY_LIST={South Africa:ZA;Mauritius:MU}

# South Africa credentials (from Investec Online -> Programmable Banking -> Open API)
ZA_CLIENT_ID=
ZA_CLIENT_SECRET=
ZA_API_KEY=

# Mauritius credentials
MU_CLIENT_ID=
MU_CLIENT_SECRET=
MU_API_KEY=

# Optional legacy fallback, used for any country above that has no <CODE>_* values.
# INVESTEC_CLIENT_ID=
# INVESTEC_CLIENT_SECRET=
# INVESTEC_API_KEY=
